<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Đang focus: viền vàng ánh đèn -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cine_input" />
            <stroke android:width="2dp" android:color="@color/cine_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cine_input" />
            <stroke android:width="1dp" android:color="@color/cine_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
