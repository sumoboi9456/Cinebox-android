<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng phim trong RecyclerView: poster + tên + năm/thể loại + điểm + nút tim -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Cine.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgPoster"
        android:layout_width="80dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_cine_poster"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTitle"
            style="@style/Widget.Cine.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Tên phim"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMeta"
            style="@style/Widget.Cine.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start"
            android:text="2010 • Hành động" />

        <TextView
            android:id="@+id/txtRating"
            style="@style/Widget.Cine.Rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="★ 8.4" />
    </LinearLayout>

    <!-- ♡ chưa thích / ♥ đã thích (đổi chữ bằng code) -->
    <TextView
        android:id="@+id/btnFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="♡"
        android:textColor="@color/cine_gold"
        android:textSize="26sp" />
</LinearLayout>
