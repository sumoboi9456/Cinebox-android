<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cine_login" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            style="@style/Widget.Cine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginTop="160dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="90dp"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Cine.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CINEBOX" />

            <TextView
                style="@style/Widget.Cine.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mỗi bộ phim, một câu chuyện" />

            <EditText
                android:id="@+id/edtUsername"
                style="@style/Widget.Cine.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="Tên đăng nhập"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/edtPassword"
                style="@style/Widget.Cine.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Mật khẩu"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/chkRemember"
                style="@style/Widget.Cine.CheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ghi nhớ đăng nhập" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                style="@style/Widget.Cine.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Đăng nhập" />

            <TextView
                android:id="@+id/txtGoRegister"
                style="@style/Widget.Cine.Link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chưa có tài khoản? Đăng ký" />


        </LinearLayout>
    </ScrollView>
</FrameLayout>
