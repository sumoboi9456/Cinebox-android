<?xml version="1.0" encoding="utf-8"?>
<!-- Màn chi tiết phim: thông tin, 4 nút hành động, ghi chú cá nhân, đánh giá -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cine_main" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="72dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/imgPoster"
                android:layout_width="160dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_cine_poster"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/txtTitle"
                style="@style/Widget.Cine.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tên phim"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/txtMeta"
                style="@style/Widget.Cine.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2010 • Hành động" />

            <TextView
                android:id="@+id/txtRating"
                style="@style/Widget.Cine.Rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="★ 8.4" />

            <TextView
                android:id="@+id/txtCommunity"
                style="@style/Widget.Cine.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cộng đồng CineBox: chưa có đánh giá" />

            <TextView
                android:id="@+id/txtOverview"
                style="@style/Widget.Cine.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mô tả phim..." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTrailer"
                    style="@style/Widget.Cine.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xem trailer"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFavorite"
                    style="@style/Widget.Cine.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="♡ Yêu thích"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.Cine.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chia sẻ"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCinema"
                    style="@style/Widget.Cine.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Tìm rạp gần đây"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Ghi chú cá nhân: chỉ hiện khi phim đã được yêu thích, lưu bằng SQLite -->
            <LinearLayout
                android:id="@+id/layoutNote"
                style="@style/Widget.Cine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Cine.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú cá nhân của bạn"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNote"
                    style="@style/Widget.Cine.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="top|start"
                    android:hint="Ví dụ: xem cùng bạn bè cuối tuần..."
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveNote"
                    style="@style/Widget.Cine.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Lưu ghi chú" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Cine.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="start"
                android:text="ĐÁNH GIÁ"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtNoReview"
                style="@style/Widget.Cine.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:text="Chưa có đánh giá nào" />

            <!-- Các dòng đánh giá được thêm vào đây bằng code (item_review.xml) -->
            <LinearLayout
                android:id="@+id/layoutReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                style="@style/Widget.Cine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtFormTitle"
                    style="@style/Widget.Cine.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gửi đánh giá của bạn"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.Cine.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điểm của bạn:" />

                    <Spinner
                        android:id="@+id/spnScore"
                        android:layout_width="90dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edtComment"
                    style="@style/Widget.Cine.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="top|start"
                    android:hint="Viết bình luận..."
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSendReview"
                    style="@style/Widget.Cine.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Gửi đánh giá" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeleteReview"
                    style="@style/Widget.Cine.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Xóa đánh giá"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Nút mũi tên quay về màn hình trước -->
    <!-- Nút mũi tên quay về màn hình trước (Đã chỉnh to ra và hạ thấp xuống để tránh Status Bar) -->
    <!-- Nút mũi tên quay về (Đã bỏ khung và đổi thành màu đen) -->
    <!-- Nút mũi tên quay về (Đã bỏ khung và đổi thành màu đen) -->
    <!-- Nút mũi tên quay về (Đã đổi sang màu trắng sáng, in đậm và phóng to 42sp) -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="←"
        android:textColor="#FFFFFF"
        android:textSize="42sp"
        android:textStyle="bold" />

</FrameLayout>
