<?xml version="1.0" encoding="utf-8"?>
<!-- Khung chính: thanh tiêu đề + vùng chứa Fragment + thanh 3 tab -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cine_main" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Thanh tiêu đề -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="34dp"
            android:paddingTop="12dp"
            android:paddingEnd="26dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/txtAppTitle"
                style="@style/Widget.Cine.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="CINEBOX"
                android:textSize="22sp" />

            <!-- Nhấn để mở PopupMenu (sắp xếp, xuất file, đăng xuất) -->
            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/cine_gold"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Banner ngoại tuyến: hiện/ẩn bằng BroadcastReceiver -->
        <TextView
            android:id="@+id/txtOffline"
            style="@style/Widget.Cine.Banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="6dp"
            android:text="Đang ngoại tuyến – hiển thị dữ liệu đã lưu"
            android:visibility="gone" />

        <!-- Nơi gắn Fragment (chừa lề 22dp hai bên để nội dung không đè lên dải phim) -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_weight="1" />

        <!-- Thanh tab dưới cùng -->
        <LinearLayout
            style="@style/Widget.Cine.TabBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabExplore"
                style="@style/Widget.Cine.Tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🎬 Khám phá" />

            <TextView
                android:id="@+id/tabFavorite"
                style="@style/Widget.Cine.Tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="♥ Yêu thích" />

            <TextView
                android:id="@+id/tabAccount"
                style="@style/Widget.Cine.Tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="👤 Tài khoản" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
