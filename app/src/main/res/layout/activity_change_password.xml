<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cine_main" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            style="@style/Widget.Cine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginTop="90dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="40dp"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Cine.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ĐỔI MẬT KHẨU"
                android:textSize="22sp" />

            <TextView
                style="@style/Widget.Cine.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mật khẩu mới tối thiểu 6 ký tự" />

            <EditText
                android:id="@+id/edtOld"
                style="@style/Widget.Cine.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Mật khẩu hiện tại"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/edtNew"
                style="@style/Widget.Cine.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Mật khẩu mới"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/edtConfirm"
                style="@style/Widget.Cine.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Nhập lại mật khẩu mới"
                android:inputType="textPassword" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChange"
                style="@style/Widget.Cine.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Đổi mật khẩu" />
        </LinearLayout>
    </ScrollView>

    <!-- Nút mũi tên quay về màn hình trước -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_cine_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="←"
        android:textColor="@color/cine_gold"
        android:textSize="26sp"
        android:textStyle="bold" />

</FrameLayout>
